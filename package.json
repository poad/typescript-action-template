{
  "name": "typescript-action",
  "version": "0.0.1",
  "private": true,
  "description": "TypeScript template action",
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "lint-fix": "oxfmt && oxlint --fix",
    "lint": "oxfmt --check && oxlint",
    "test": "vitest run --silent=false --coverage",
    "package": "ncc build --source-map --license licenses.txt -q --target es2023",
    "all": "rm -rf dist && pnpm build && pnpm lint && pnpm package && pnpm test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vercel/ncc": "^0.43.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.18.1",
      "onFail": "download"
    }
  }
}
